<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:DiscImageStudio.Desktop.Localization"
             xmlns:vm="using:DiscImageStudio.Desktop.ViewModels"
             xmlns:svc="using:DiscImageStudio.Desktop.Services"
             xmlns:controls="using:DiscImageStudio.Desktop.Controls"
             x:Class="DiscImageStudio.Desktop.Views.BurnView"
             x:DataType="vm:BurnPageViewModel">
  <Grid Margin="{StaticResource PagePadding}" RowDefinitions="Auto,*">

    <controls:PageHeader Title="{loc:Loc Xaml.Burn}" Badge="{Binding FamilyLabel}"
                         Subtitle="把导出的音轨或镜像写进空白盘。只对可报废的盘操作。">
      <controls:PageHeader.Actions>
        <Button Classes="ghost" Content="回到导出" Command="{Binding GoBackCommand}"
                Background="{DynamicResource Surface2Brush}" Padding="14,0" />
      </controls:PageHeader.Actions>
    </controls:PageHeader>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

      <ScrollViewer>
        <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">

          <controls:SectionCard Header="光驱" Icon="{StaticResource IconHardDrive}">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                          HorizontalAlignment="Stretch" Height="{StaticResource ControlHeight}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="svc:BurnDevice">
                      <TextBlock Text="{Binding DisplayName}" FontSize="13" TextWrapping="NoWrap" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1" Classes="ghost" Content="刷新设备" Height="{StaticResource ControlHeight}"
                        Padding="12,0" Background="{DynamicResource Surface2Brush}"
                        Command="{Binding RefreshDevicesCommand}" />
              </Grid>
              <TextBlock Classes="micro" Text="{Binding MediaSummary}" TextWrapping="Wrap" />
              <TextBlock Classes="micro" Text="{Binding BackendName, StringFormat='后端：{0}'}" />
            </StackPanel>
          </controls:SectionCard>

          <controls:SectionCard Header="要刻的文件" Icon="{StaticResource IconFileDown}">
            <StackPanel Spacing="10">
              <controls:PathField Label="源文件" Text="{Binding SourcePath, Mode=TwoWay}"
                                  ButtonLabel="选择…" Command="{Binding BrowseSourceCommand}" />
              <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                <TextBlock Classes="micro" Text="速度倍速（留空跟随盘片）：" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding SpeedText}" Width="80"
                         Height="{StaticResource CompactHeight}" PlaceholderText="如 8" />
              </Grid>
            </StackPanel>
          </controls:SectionCard>

          <controls:SectionCard Header="开始" Icon="{StaticResource IconFlame}">
            <StackPanel Spacing="10">
              <ProgressBar Value="{Binding Progress}" Maximum="1" Height="8"
                           IsIndeterminate="{Binding IsBurning}" />
              <TextBlock Classes="micro" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="开始刻录" Command="{Binding BurnCommand}"
                        IsEnabled="{Binding CanBurn}" />
                <Button Classes="ghost" Content="取消" Command="{Binding CancelCommand}"
                        IsEnabled="{Binding IsBurning}" Background="{DynamicResource Surface2Brush}" />
              </StackPanel>
            </StackPanel>
          </controls:SectionCard>

        </StackPanel>
      </ScrollViewer>

      <Border Grid.Column="1" Classes="card" Width="380" Margin="16,0,0,0">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="刻录日志" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
          <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Log}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Classes="micro" TextWrapping="Wrap" Margin="0,0,0,2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
