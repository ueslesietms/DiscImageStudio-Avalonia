<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:DiscImageStudio.Desktop.Localization"
        x:Class="DiscImageStudio.Desktop.Views.PresetNameWindow"
        Title="{loc:Loc Xaml.SaveAsPreset}"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}">
  <Grid RowDefinitions="*,Auto" Margin="20">

    <Border Classes="card" Padding="16">
      <StackPanel Spacing="8">
        <TextBlock Text="{loc:Loc Xaml.PresetName}" Classes="muted" />
        <TextBox x:Name="NameBox" MaxLength="80" />
        <TextBlock Text="名称不能为空；同名会写进用户预设目录，磁盘上的参数不会被改动。"
                   Classes="micro" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,16,0,0">
      <Button Grid.Column="1" Classes="ghost" Content="{loc:Loc Xaml.Cancel}" Click="Cancel_Click" />
      <Button Grid.Column="2" Classes="primary" Content="{loc:Loc Xaml.Save}" Click="Save_Click"
              IsDefault="True" Margin="8,0,0,0" />
    </Grid>
  </Grid>
</Window>
