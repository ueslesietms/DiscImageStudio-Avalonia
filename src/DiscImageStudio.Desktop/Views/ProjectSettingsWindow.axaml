<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DiscImageStudio.Desktop.ViewModels"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:Class="DiscImageStudio.Desktop.Views.ProjectSettingsWindow"
        x:DataType="vm:ProjectSettingsViewModel"
        Title="工程设置"
        Width="460" Height="320"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}">
  <Grid RowDefinitions="*,Auto" Margin="20">

    <StackPanel Spacing="16">
      <TextBlock Classes="title" FontSize="18" Text="工程设置" />
      <TextBlock Classes="micro" TextWrapping="Wrap"
                 Text="工程层面的信息。盘片几何、三项轨距和预设请打开「盘片设置」。" />

      <StackPanel Spacing="6">
        <TextBlock Classes="micro" Text="工程名" />
        <TextBox Text="{Binding Name}" Height="{StaticResource ControlHeight}" />
      </StackPanel>

      <TextBlock Classes="micro" Foreground="{DynamicResource DangerBrush}"
                 Text="{Binding ErrorMessage}"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
      <Button Classes="ghost" Content="取消" Height="{StaticResource ButtonHeight}" Padding="16,0"
              Click="Cancel_Click" />
      <Button Classes="primary" Content="保存" Command="{Binding SaveCommand}" />
    </StackPanel>
  </Grid>
</Window>
