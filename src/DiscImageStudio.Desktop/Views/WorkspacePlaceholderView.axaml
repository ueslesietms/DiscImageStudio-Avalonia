<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiscImageStudio.Desktop.ViewModels"
             x:Class="DiscImageStudio.Desktop.Views.WorkspacePlaceholderView"
             x:DataType="vm:WorkspacePageViewModel">
  <Grid Margin="{StaticResource PagePadding}" RowDefinitions="Auto,*">
    <StackPanel Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Path Classes="icon" Data="{Binding Icon}" Width="20" Height="20"
              Stroke="{DynamicResource PrimaryBrush}" />
        <TextBlock Classes="title" Text="{Binding Title}" />
      </StackPanel>
      <TextBlock Classes="secondary" Text="{Binding Subtitle}" />
    </StackPanel>

    <Border Grid.Row="1" Classes="card" Margin="0,22,0,0">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
        <TextBlock Text="{Binding Placeholder}" Classes="secondary" HorizontalAlignment="Center" />
        <TextBlock Text="（Avalonia 骨架阶段）" Classes="micro" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
